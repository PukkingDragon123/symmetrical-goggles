{
  "schemaVersion": 1,
  "id": "winterworks",
  "version": "${version}",
  "name": "Winterworks",
  "description": "A winter contraptions mod: the Snowball Launcher, the Icebreaker, the Winter Express trains and the Snow Globe. Models, textures and animations are made with lowpix.",
  "authors": ["lowpix"],
  "license": "MIT",
  "icon": "assets/winterworks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.lowpix.winterworks.Winterworks"],
    "client": ["dev.lowpix.winterworks.client.WinterworksClient"]
  },
  "mixins": ["winterworks.mixins.json"],
  "accessWidener": "winterworks.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
