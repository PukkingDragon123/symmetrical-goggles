{
  "schemaVersion": 1,
  "id": "winterworks",
  "version": "${version}",
  "name": "Winterworks",
  "description": "A winter mod: the Snowball Launcher, the Icebreaker, the Winter Express trains, the Snow Globe, and the Cold Zone: Ice Caves, the cold, remade polar bears, fur armour, the Frost Mauler boss and Fang Daggers. Models, textures and animations are made with lowpix.",
  "authors": [
    "lowpix"
  ],
  "license": "MIT",
  "icon": "assets/winterworks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.lowpix.winterworks.Winterworks"
    ],
    "client": [
      "dev.lowpix.winterworks.client.WinterworksClient"
    ],
    "fabric-gametest": [
      "dev.lowpix.winterworks.test.WinterworksTests",
      "dev.lowpix.winterworks.test.ColdTests",
      "dev.lowpix.winterworks.test.BossTests",
      "dev.lowpix.winterworks.test.BearTests",
      "dev.lowpix.winterworks.test.DaggerTests",
      "dev.lowpix.winterworks.test.AmberTests",
      "dev.lowpix.winterworks.test.GolemTests",
      "dev.lowpix.winterworks.test.ArchaeologyTests",
      "dev.lowpix.winterworks.test.HexTests",
      "dev.lowpix.winterworks.test.CurseTests",
      "dev.lowpix.winterworks.test.NetherTests"
    ]
  },
  "mixins": [
    "winterworks.mixins.json"
  ],
  "accessWidener": "winterworks.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
