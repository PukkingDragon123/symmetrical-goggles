{
  "name": "Lamplighter Bot",
  "description": "Original hard-surface robot: chamfered ivory enamel shell with teal bands, gunmetal joints, glowing amber camera-iris eye, oil-tank backpack with a glowing chimney, pincer hands and a hanging lantern. Panel grooves, rivets, vents, chipped paint and hazard stripes are all procedural.",
  "author": "lowpix example",
  "license": "CC0-1.0",
  "density": 2,
  "budget": {"tris": 1200, "colors": 56},
  "light": {"dir": [-0.55, 1.0, 0.7], "strength": 1.1, "gradient": 0.35, "ao": 0.9, "ao_height": 3.0},
  "render": {"background": "#202432", "hero": [-34, 18], "shadow": 0.45},

  "palette": {"ramps": {
    "shell": ["#2b2321", "#4a3c35", "#76645a", "#a8957f", "#d2c2a4", "#efe4c8", "#fffaf0"],
    "teal":  ["#08201f", "#0e3a38", "#145a55", "#1d7d73", "#2fa494", "#62c9b4", "#a8ecd8"],
    "metal": ["#0f1114", "#1d2126", "#2e343b", "#454d56", "#66707b", "#8f99a3", "#c3cbd2"],
    "glow":  ["#4a1d05", "#8a3a08", "#cf6a10", "#f5a128", "#ffd25a", "#fff3b0", "#ffffff"],
    "red":   ["#2a0a0e", "#5c1219", "#9a1f26", "#d63a35", "#f2725a"],
    "warn":  ["#3a2a06", "#7a5a0a", "#d9a514", "#ffd23a"]
  }},

  "styles": {
    "enamel": {
      "ramp": "shell", "tone": 3.9, "dither": 0.0,
      "rim": {"light": 1, "dark": 1, "outline": "dark"},
      "layers": [
        {"id": "mottle", "op": "noise", "scale": 2.0, "amount": 0.25},
        {"id": "panel", "op": "panel", "inset": 2, "min_size": 11},
        {"id": "grime", "op": "patches", "scale": 1.8, "threshold": 0.72, "shift": -0.5, "faces": ["-top"]},
        {"id": "wear", "op": "wear", "width": 2, "density": 0.16, "ramp": "metal", "tone": 2.2, "post": true},
        {"id": "rivets", "op": "rivets", "inset": 1, "min_size": 9, "post": true}
      ]
    },
    "teal": {
      "ramp": "teal", "tone": 3.5, "dither": 0.0,
      "rim": {"light": 1, "dark": 1, "outline": "dark"},
      "layers": [
        {"id": "mottle", "op": "noise", "scale": 2.0, "amount": 0.3},
        {"id": "panel", "op": "panel", "inset": 1, "min_size": 9},
        {"id": "wear", "op": "wear", "width": 2, "density": 0.16, "ramp": "metal", "tone": 2.4, "post": true},
        {"id": "rivets", "op": "rivets", "inset": 1, "min_size": 8, "post": true}
      ]
    },
    "gun": {
      "ramp": "metal", "tone": 2.9, "dither": 0.0,
      "rim": {"light": 1, "dark": 1, "outline": "dark"},
      "layers": [
        {"id": "mottle", "op": "noise", "scale": 1.6, "amount": 0.35},
        {"id": "scuffs", "op": "wear", "width": 1, "density": 0.25, "shift": 1.2, "post": true},
        {"id": "rivets", "op": "rivets", "inset": 1, "min_size": 8, "post": true}
      ]
    },
    "glow": {
      "ramp": "glow", "tone": 4.3, "light": 0.25, "dither": 0.0, "rim": {"light": 1, "dark": 0, "light_shift": 1.5},
      "layers": [{"id": "hot", "op": "noise", "scale": 1.2, "amount": 0.5}]
    }
  },

  "animations": {
    "idle": {"length": 3.2, "loop": true, "tracks": [
      {"part": "hips", "channel": "position", "osc": {"axis": "y", "amp": 0.12, "cycles": 1}},
      {"part": "helmet", "keys": [[0, [0, 0, 0]], [0.5, [0, -16, -3]], [1.3, [0, -16, -3]], [1.8, [3, 12, 4]], [2.6, [3, 12, 4]], [3.2, [0, 0, 0]]], "ease": "back"},
      {"part": "lens", "channel": "scale", "osc": {"amp": [0.1, 0.1, 0.0], "cycles": 2}},
      {"part": "antenna", "osc": {"axis": "z", "amp": 5, "cycles": 2, "phase": 0.1}},
      {"part": "antenna", "osc": {"axis": "x", "amp": 3, "cycles": 3}},
      {"part": "bulb", "channel": "scale", "osc": {"amp": [0.35, 0.35, 0.35], "cycles": 2, "shape": "pulse"}},
      {"part": "handle", "osc": {"axis": "z", "amp": 7, "cycles": 1}},
      {"part": "handle", "osc": {"axis": "x", "amp": 3, "cycles": 1, "phase": 0.25}},
      {"part": "ember", "channel": "scale", "osc": {"amp": [0.25, 0.25, 0.5], "cycles": 5}},
      {"part": "l_upper", "osc": {"axis": "x", "amp": 4, "cycles": 1, "phase": 0.15}},
      {"part": "l_fore", "osc": {"axis": "x", "amp": 5, "cycles": 1, "phase": 0.3}}
    ]},
    "wave": {"length": 2.4, "loop": true, "tracks": [
      {"part": "l_upper", "keys": [[0, [0, 0, 0]], [0.35, [12, 0, 0]], [0.7, [-112, 0, -40]], [1.9, [-112, 0, -40]], [2.4, [0, 0, 0]]], "ease": "back"},
      {"part": "l_fore", "keys": [[0, [0, 0, 0]], [0.7, [-20, 0, 0]], [1.9, [-20, 0, 0]], [2.4, [0, 0, 0]]], "ease": "ease"},
      {"part": "l_fore", "keys": [[0, [0, 0, 0]], [0.7, [0, 0, 0]], [0.95, [0, 0, 26]], [1.2, [0, 0, -22]], [1.45, [0, 0, 26]], [1.7, [0, 0, -22]], [1.9, [0, 0, 0]], [2.4, [0, 0, 0]]], "ease": "ease"},
      {"part": "l_claw_a", "keys": [[0, 0], [0.7, -25], [1.9, -25], [2.4, 0]], "axis": "x", "ease": "back"},
      {"part": "l_claw_b", "keys": [[0, 0], [0.7, 25], [1.9, 25], [2.4, 0]], "axis": "x", "ease": "back"},
      {"part": "helmet", "keys": [[0, [0, 0, 0]], [0.7, [-4, -14, -9]], [1.9, [-4, -14, -9]], [2.4, [0, 0, 0]]], "ease": "back"},
      {"part": "lens", "channel": "scale", "keys": [[0, [0, 0, 0]], [0.7, [0.18, 0.18, 0]], [1.9, [0.18, 0.18, 0]], [2.4, [0, 0, 0]]], "ease": "ease"},
      {"part": "chest", "keys": [[0, [0, 0, 0]], [0.7, [0, 0, 3]], [1.9, [0, 0, 3]], [2.4, [0, 0, 0]]], "ease": "ease"},
      {"part": "handle", "osc": {"axis": "z", "amp": 6, "cycles": 2}}
    ]},
    "walk": {"length": 1.2, "loop": true, "tracks": [
      {"part": "thigh", "osc": {"axis": "x", "amp": 20, "cycles": 1}, "mirror_phase": 0.5},
      {"part": "shin", "osc": {"axis": "x", "amp": 13, "bias": 13, "cycles": 1, "phase": 0.3}, "mirror_phase": 0.5},
      {"part": "boot", "osc": {"axis": "x", "amp": 8, "cycles": 1, "phase": 0.55}, "mirror_phase": 0.5},
      {"part": "hips", "channel": "position", "osc": {"axis": "y", "amp": 0.55, "cycles": 2, "phase": 0.25, "shape": "bounce"}},
      {"part": "hips", "osc": {"axis": "z", "amp": 3, "cycles": 1}},
      {"part": "chest", "osc": {"axis": "y", "amp": 5, "cycles": 1, "phase": 0.5}},
      {"part": "helmet", "osc": {"axis": "z", "amp": -3, "cycles": 1, "phase": 0.1}},
      {"part": "r_upper", "osc": {"axis": "x", "amp": 12, "cycles": 1, "phase": 0.5}},
      {"part": "l_upper", "osc": {"axis": "x", "amp": 12, "cycles": 1}},
      {"part": "handle", "osc": {"axis": "x", "amp": 12, "cycles": 1, "phase": 0.65}},
      {"part": "antenna", "osc": {"axis": "z", "amp": 7, "cycles": 2, "phase": 0.2}},
      {"part": "ember", "channel": "scale", "osc": {"amp": [0.25, 0.25, 0.5], "cycles": 4}}
    ]}
  },

