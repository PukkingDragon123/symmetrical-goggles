         {"id": "lip", "op": "band", "axis": "y", "from": -1.0, "to": -0.82, "ramp": "mouth", "tone": 0.4, "faces": ["flanks", "front"]}
       ],
       "stamps": [
         {"face": "front", "at": "top", "offset": [0, 2], "art": ["n......n", "nn....nn"], "key": {"n": "skin:0"}}
       ]
     }},

    {"id": "jaw", "parent": "head", "shape": "taper", "size": [12.0, 2.2, 10.6], "pivot": [0, -3.6, 0.2], "offset": [0, 0, 4.9],
     "rotation": [4, 0, 0], "front_scale": [0.72, 0.8], "back_scale": [0.9, 1.0], "hide": ["back"], "style": "skin",
     "paint": {"tone": 1.8, "layers": [
       {"id": "lip", "op": "band", "axis": "y", "from": 0.55, "to": 1.0, "ramp": "mouth", "tone": 0.6, "faces": ["flanks", "front"]},
       {"id": "jaw_spots", "op": "spots", "count": 2, "radius": [0.7, 1.0], "ramp": "gold", "tone": 3.0, "faces": ["flanks"], "seed": 2, "bevel": true}
     ]}},

    {"id": "eye", "parent": "head", "shape": "prism", "sides": 6, "size": [5.4, 5.4, 2.4], "pivot": [5.0, 2.1, 6.6],
     "rotation": [0, 60, 42], "front_scale": [0.9, 0.9], "hide": ["back"], "mirror": true, "style": "skin",
     "paint": {"tone": 3.0,
       "layers": [{"id": "lid", "op": "band", "axis": "y", "from": 0.15, "to": 1.0, "ramp": "gold", "tone": 3.6, "faces": ["sides"],
                   "bevel": {"shadow": 1, "highlight": 0, "shadow_shift": -2.0}}],
       "stamps": [{"face": "front", "at": [0, 0],
       "art": [
