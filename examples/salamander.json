{
  "name": "Ember Salamander",
  "description": "Original low-poly, pixel-painted fire salamander: glossy ink-black skin, molten gold blotches, bronze-ringed eyes, parotoid glands, costal grooves, splayed sprawl and an S-curved tail.",
  "author": "lowpix example",
  "license": "CC0-1.0",
  "density": 2,
  "budget": {"tris": 320, "colors": 48},
  "light": {"dir": [-0.55, 1.0, 0.65], "strength": 1.0, "gradient": 0.6, "ao": 0.9, "ao_height": 3.2},
  "render": {"background": "#1f2b26", "hero": [38, 26], "shadow": 0.5},

  "palette": {"ramps": {
    "skin":  ["#07060b", "#110f19", "#1c1828", "#2a253b", "#3c3553", "#564e72", "#7d7699", "#aba6c4"],
    "gold":  ["#3d1006", "#7a240a", "#b9440d", "#e2701a", "#f59f2a", "#ffcb48", "#fff09a"],
    "belly": ["#0e0b13", "#1a1520", "#28212e", "#3a2f3f", "#514253"],
    "eye":   ["#020104", "#0b0810", "#1a1420", "#4f3420", "#9a6a34", "#e2b86c", "#ffffff"],
    "mouth": ["#1a060c", "#3d0e19", "#6e1f2c"]
  }},

  "styles": {
    "skin": {
      "ramp": "skin", "tone": 2.0, "dither": 0.0,
      "rim": {"light": 1, "dark": 1, "light_shift": 1.0, "dark_shift": -1.0, "outline": "dark"},
      "layers": [
        {"id": "mottle", "op": "noise", "scale": 2.6, "amount": 0.4},
        {"id": "belly_band", "op": "band", "axis": "y", "from": -1.0, "to": -0.7, "ramp": "belly", "tone": 2.2,
         "faces": ["sides", "-front", "-back"], "wobble": 0.12},
        {"id": "belly", "op": "fill", "ramp": "belly", "tone": 2.0, "faces": ["bottom"]},
        {"id": "pores", "op": "spots", "count": 6, "radius": [0.3, 0.5], "roughness": 0.0, "shift": -1.0, "faces": ["-bottom"]},
        {"id": "gloss", "op": "gloss", "post": true, "dash": true, "length": 3, "inset": 1, "density": 0.4, "shift": 2.0, "ramps": ["skin"]}
      ]
    },
    "blotches": {
      "layers": [
        {"id": "blotch", "op": "spots", "ramp": "gold", "tone": 3.7, "count": 0, "roughness": 0.45, "rough_scale": 1.1,
         "bevel": {"shadow": 1, "highlight": 1, "shadow_shift": -2.0, "highlight_shift": 1.2}, "faces": ["-bottom"]},
        {"id": "grain", "op": "noise", "scale": 1.4, "amount": 0.35}
      ]
    },
    "grooves": {
      "layers": [
        {"id": "costal", "op": "stripes", "axis": "z", "period": 2.4, "width": 0.18, "shift": -1.1,
         "faces": ["flanks"], "range": [-1.0, 1.0]}
      ]
    },
    "gold_gland": {
      "ramp": "gold", "tone": 3.6, "dither": 0.3,
      "rim": {"light": 1, "dark": 1, "outline": "dark"},
      "layers": [
        {"op": "noise", "scale": 1.2, "amount": 0.4},
        {"id": "gland_pores", "op": "spots", "count": 7, "radius": [0.25, 0.4], "ramp": "gold", "tone": 1.2,
         "roughness": 0.0, "faces": ["top", "flanks"], "min_gap": 1.4},
        {"op": "gloss", "post": true, "density": 0.03, "edge": 2}
      ]
    },
    "toes": {
      "ramp": "skin", "tone": 3.4, "rim": {"light": 0, "dark": 0}, "art_key": {"t": "skin:6", "s": "skin:2"}
    }
  },

  "parts": [
    {"id": "chest", "shape": "taper", "size": [12.6, 7.4, 11.4], "pivot": [0, 6.0, 0], "offset": [0, 0, 5.5],
     "front_scale": [0.86, 0.9], "hide": ["back"], "style": ["skin", "blotches", "grooves"],
     "paint": {"layers": [
       {"id": "blotch", "count": 5, "radius": [1.3, 2.0], "stretch": [1, 1, 1.5], "where": {"y": [-0.1, 1.0]}, "seed": 3}
     ]}},

    {"id": "belly", "parent": "chest", "shape": "taper", "size": [13.8, 7.8, 10.8], "pivot": [0, 0.1, 0.3], "offset": [0, 0, -5.0],
     "rotation": [0, -7, 0], "front_scale": [0.97, 0.97], "hide": ["front"], "style": ["skin", "blotches", "grooves"],
     "paint": {"layers": [
       {"id": "blotch", "count": 5, "radius": [1.3, 2.1], "stretch": [1, 1, 1.6], "where": {"y": [-0.1, 1.0]}, "seed": 11}
     ]}},

    {"id": "hips", "parent": "belly", "shape": "taper", "size": [13.0, 7.2, 9.8], "pivot": [0, -0.1, -10.0], "offset": [0, 0, -4.6],
