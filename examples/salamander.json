    {"id": "gland", "parent": "head", "shape": "taper", "size": [3.8, 1.8, 5.0], "pivot": [4.4, 2.4, 2.2],
     "rotation": [-4, -12, 14], "front_scale": [0.7, 0.6], "back_scale": [0.8, 0.7], "hide": ["bottom"], "mirror": true,
