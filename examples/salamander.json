{
  "name": "Ember Salamander",
  "description": "Original low-poly, pixel-painted fire salamander. One continuous S-curved loft body, rounded chamfered head, domed bronze eyes under golden lids, parotoid glands, molten blotches, costal grooves and a crest of pixel-art flames along the spine.",
  "author": "lowpix example",
  "license": "CC0-1.0",
  "density": 2,
  "budget": {"tris": 900, "colors": 48},
  "light": {"dir": [-0.55, 1.0, 0.65], "strength": 1.15, "gradient": 0.5, "ao": 0.9, "ao_height": 3.0},
  "render": {"background": "#1f2b26", "hero": [38, 24], "shadow": 0.5},

  "palette": {"ramps": {
    "skin":  ["#07060b", "#110f19", "#1c1828", "#2a253b", "#3c3553", "#564e72", "#7d7699", "#aba6c4"],
    "gold":  ["#3d1006", "#7a240a", "#b9440d", "#e2701a", "#f59f2a", "#ffcb48", "#fff09a"],
    "belly": ["#0e0b13", "#1a1520", "#28212e", "#3a2f3f", "#514253"],
    "eye":   ["#020104", "#0b0810", "#1a1420", "#4f3420", "#9a6a34", "#e2b86c", "#ffffff"],
    "mouth": ["#1a060c", "#3d0e19", "#6e1f2c"]
  }},

  "styles": {
    "skin": {
      "ramp": "skin", "tone": 2.1, "dither": 0.0,
      "layers": [
        {"id": "mottle", "op": "noise", "scale": 2.4, "amount": 0.35},
        {"id": "belly", "op": "fill", "ramp": "belly", "tone": 2.2, "faces": ["bottom"]},
        {"id": "pores", "op": "spots", "count": 10, "radius": [0.3, 0.5], "roughness": 0.0, "shift": -1.0, "faces": ["-bottom"]},
        {"id": "sheen", "op": "patches", "scale": 1.1, "threshold": 0.66, "shift": 1.6, "min_light": 0.72, "post": true}
      ]
    },
    "blotches": {
      "layers": [
        {"id": "blotch", "op": "spots", "ramp": "gold", "tone": 3.8, "count": 0, "roughness": 0.45, "rough_scale": 1.1,
         "bevel": {"shadow": 1, "highlight": 1, "shadow_shift": -2.0, "highlight_shift": 1.2}, "faces": ["-bottom"]},
        {"id": "grain", "op": "noise", "scale": 1.4, "amount": 0.3}
      ]
    },
    "flame": {
      "ramp": "gold", "tone": 4, "light": 0.0, "rim": {"light": 0, "dark": 0},
      "art_key": {"w": "gold:6", "y": "gold:5", "o": "gold:4", "a": "gold:3", "r": "gold:2", "d": "gold:1"}
    },
    "toes": {"ramp": "skin", "tone": 3.6, "rim": {"light": 0, "dark": 0}, "art_key": {"t": "gold:4"}}
  },

  "parts": [
    {"id": "body", "shape": "loft", "profile": {"sides": 8, "round": 2.5}, "subdiv": 1, "caps": [false, false],
     "rings": [
       {"at": [0.0, 5.7, 13.0], "size": [10.4, 6.4]},
       {"at": [0.4, 5.9, 6.0], "size": [12.6, 7.4]},
       {"at": [-0.6, 5.9, -3.0], "size": [13.6, 7.8]},
       {"at": [-2.2, 5.6, -11.5], "size": [12.2, 7.0]},
       {"at": [-3.4, 5.0, -19.5], "size": [9.4, 6.0]},
       {"at": [-2.2, 4.2, -28.0], "size": [7.0, 4.8]},
       {"at": [1.6, 3.5, -36.0], "size": [5.0, 3.7]},
       {"at": [6.6, 3.0, -42.5], "size": [3.3, 2.6]},
       {"at": [12.4, 2.7, -46.6], "size": [1.7, 1.4]},
       {"at": [17.4, 2.5, -48.6], "size": [0.2, 0.2]}
