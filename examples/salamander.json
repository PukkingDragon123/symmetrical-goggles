     "paint": {"layers": [
       {"id": "blotch", "count": 5, "radius": [1.2, 1.9], "stretch": [1, 1, 1.5], "where": {"y": [-0.1, 1.0]}, "seed": 19}
     ]}},

    {"id": "neck", "parent": "chest", "shape": "taper", "size": [11.0, 6.4, 3.6], "pivot": [0, 0.1, 11.0], "offset": [0, 0, 1.2],
     "back_scale": [1.02, 1.04], "hide": ["front", "back"], "style": "skin"},

    {"id": "head", "parent": "neck", "shape": "taper", "size": [13.4, 5.6, 11.4], "pivot": [0, 0.9, 2.6], "offset": [0, 0, 4.9],
     "rotation": [-7, 11, 0], "front_scale": [0.74, 0.62], "front_shift": [0, -0.7], "back_scale": [0.92, 1.0],
